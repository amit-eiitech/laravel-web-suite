{
  "name": "eii/laravel-web-suite",
  "description": "A modular business website backend companion for Laravel, with optional Filament 5 administration.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "spatie/laravel-settings": "^3.10"
  },
  "suggest": {
    "filament/filament": "^5.0",
    "filament/spatie-laravel-settings-plugin": "^5.0",
    "spatie/laravel-medialibrary": "For advanced media-library integration.",
    "spatie/laravel-permission": "For role and permission management."
  },
  "autoload": {
    "psr-4": {
      "Eii\\WebSuite\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Eii\\WebSuite\\WebSuiteServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
